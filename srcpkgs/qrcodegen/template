# Template file for 'qrcodegen'
pkgname=qrcodegen
version=1.8.0
revision=91
short_desc="High-quality QR Code generator library"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT"
homepage="https://www.nayuki.io/page/qr-code-generator-library"
distfiles="https://github.com/nayuki/QR-Code-generator/archive/refs/tags/v${version}.tar.gz"
checksum=2ec0a4d33d6f521c942eeaf473d42d5fe139abcfa57d2beffe10c5cf7d34ae60
wrksrc="QR-Code-generator-${version}"

CXXFLAGS="-fPIC"

do_build() {
    make -C c CFLAGS="-fPIC $CFLAGS"
    make -C cpp
}

do_install() {
    vmkdir usr/include/qrcodegen
    vinstall c/qrcodegen.h 644 usr/include/qrcodegen
    vinstall cpp/qrcodegen.hpp 644 usr/include/qrcodegen
    vinstall c/libqrcodegen.a 644 usr/lib
    vinstall cpp/libqrcodegencpp.a 644 usr/lib

    vmkdir usr/lib/pkgconfig
    cat > "${DESTDIR}/usr/lib/pkgconfig/qrcodegen.pc" <<EOF
prefix=/usr
exec_prefix=\${prefix}
libdir=\${exec_prefix}/lib
includedir=\${prefix}/include/qrcodegen

Name: qrcodegen
Description: High-quality QR Code generator library
Version: ${version}
Libs: -L\${libdir} -lqrcodegen
Cflags: -I\${includedir}
EOF

    vlicense LICENSE 2>/dev/null || true
}
