# Template file for 'linux7.2-sc7280'
pkgname=linux7.2-sc7280
version=7.2.0
revision=5
_flavor="sc7280"
_series="${version%.*}"

archs="aarch64"
build_style=gnu-makefile

hostmakedepends="
    bc
    bison
    clang
    elfutils-devel
    flex
    git
    kmod
    lld
    llvm
    openssl-devel
    pahole
    perl
    python3
    tar
    xz
    zstd"

short_desc="Linux kernel ${_series} for Qualcomm SC7280/SM7325/QCM6490"
maintainer="Jaymz665 <jaymz665@gmail.com>"
license="GPL-2.0-only"
homepage="https://altlinux.space/alt-mobile/linux"

nofetch=yes
noextract=yes
wrksrc="linux"

_arch="arm64"

do_fetch() {
    msg_normal "Cloning linux (alt/sc7280)...\n"
    git clone --depth 1 --branch alt/sc7280 \
        https://altlinux.space/alt-mobile/linux.git "${wrksrc}"
}

do_configure() {
    if [ -n "$XBPS_CROSS_TRIPLET" ]; then
        export CROSS_COMPILE="${XBPS_CROSS_TRIPLET}-"
    fi
    export LLVM=1 ARCH=${_arch}

    scripts/kconfig/merge_config.sh -m -O . \
        "${FILESDIR}/defconfig" \
        "${FILESDIR}/sc7280.config" \
        "${FILESDIR}/misc.config" \
        "${FILESDIR}/pmos.config" \
        "${FILESDIR}/altlinux.config"

    sed -i \
        -e "s|^CONFIG_LOCALVERSION=.*|CONFIG_LOCALVERSION=\"-${_flavor}\"|" \
        -e 's|^CONFIG_LOCALVERSION_AUTO=y|# CONFIG_LOCALVERSION_AUTO is not set|' \
        .config

    make ${makejobs} olddefconfig

    grep '^CONFIG_LOCALVERSION' .config || true
    grep '^CONFIG_MODULES=' .config || true
    grep '^CONFIG_ARCH_QCOM' .config || true
    echo "=== Q6VOICE in config ==="
    grep -iE 'Q6VOICE|SND_SOC_SM8250' .config | head -10
}

do_build() {
    if [ -n "$XBPS_CROSS_TRIPLET" ]; then
        export CROSS_COMPILE="${XBPS_CROSS_TRIPLET}-"
    fi
    export LLVM=1 ARCH=${_arch}

    make ${makejobs} all
    make ${makejobs} dtbs
}

do_install() {
    if [ -n "$XBPS_CROSS_TRIPLET" ]; then
        export CROSS_COMPILE="${XBPS_CROSS_TRIPLET}-"
    fi
    export LLVM=1 ARCH=${_arch}

    make ${makejobs} \
        INSTALL_MOD_PATH="${DESTDIR}/usr" \
        INSTALL_MOD_STRIP=1 \
        INSTALL_DTBS_PATH="${DESTDIR}/boot/dtbs" \
        modules_install dtbs_install

    vmkdir boot

    if [ -f "arch/${_arch}/boot/vmlinuz.efi" ]; then
        cp "arch/${_arch}/boot/vmlinuz.efi" "${DESTDIR}/boot/linux.efi"
    fi

    if [ -f "arch/${_arch}/boot/vmlinuz" ]; then
        cp "arch/${_arch}/boot/vmlinuz" "${DESTDIR}/boot/vmlinuz"
    elif [ -f "arch/${_arch}/boot/Image.gz" ]; then
        cp "arch/${_arch}/boot/Image.gz" "${DESTDIR}/boot/vmlinuz"
    elif [ -f "arch/${_arch}/boot/Image" ]; then
        cp "arch/${_arch}/boot/Image" "${DESTDIR}/boot/vmlinuz"
    fi

    vmkdir usr/share/kernel/${_flavor}
    cp include/config/kernel.release "${DESTDIR}/usr/share/kernel/${_flavor}/"

    rm -f ${DESTDIR}/usr/lib/modules/*/build
    rm -f ${DESTDIR}/usr/lib/modules/*/source
}

post_install() {
    vlicense COPYING
}
