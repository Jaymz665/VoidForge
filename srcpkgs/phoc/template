# Template file for 'phoc'
pkgname=phoc
version=0.52.0
revision=1
wrksrc="${pkgname}-v${version}"
build_style=meson
configure_args="
    -Dembed-wlroots=enabled
    --default-library=static
    -Dtests=false
    -Dwlroots:werror=false"
hostmakedepends="
    glib-devel
    pkg-config
    wayland-devel
    gettext
    meson
    hwids
    glslang"
makedepends="
    eudev-libudev-devel
    libcap-devel
    elogind-devel
    libdisplay-info-devel
    libseat-devel
    libxcb-devel
    xcb-util-image-devel
    xcb-util-renderutil-devel
    xcb-util-wm-devel
    xkeyboard-config
    xorg-server-xwayland
    glib-devel
    gmobile-devel
    gnome-desktop-devel
    json-glib-devel
    libdrm-devel
    libinput-devel
    libxkbcommon-devel
    MesaLib-devel
    pixman-devel
    wayland-protocols
    vulkan-loader-devel
    wlroots0.19-devel"
short_desc="Wlroots-based phone compositor for Phosh"
maintainer="Jaymz665"
license="GPL-3.0-or-later"
homepage="https://gitlab.gnome.org/World/Phosh/phoc"
distfiles="https://sources.phosh.mobi/releases/phoc/phoc-${version}.tar.xz"
checksum=817aad0114bc5e5a7ccc3ef54ce545bf1922a9c0afb2f91ccd8f91b1179aaef1

post_install() {
    if [ -d "${wrksrc}/LICENSES" ]; then
        vmkdir usr/share/licenses/phoc
        cp -r ${wrksrc}/LICENSES/* ${PKGDESTDIR}/usr/share/licenses/phoc/
    fi
}

phoc-schemas_package() {
    short_desc="Phoc schemas"
    pkg_install() {
        vmove usr/share/glib-2.0/schemas
    }
}
