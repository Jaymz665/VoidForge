# Template file for 'phoc'
pkgname=phoc
version=0.52.0
revision=2
wrksrc="${pkgname}-${version}"
build_style=meson
configure_args="
    -Dembed-wlroots=enabled
    --default-library=static
    -Dtests=false
    -Dwlroots:werror=false"
hostmakedepends="
    glib-devel
    pkg-config
    wayland-devel
    gettext
    meson
    hwids
    glslang"
makedepends="
    eudev-libudev-devel
    libcap-devel
    elogind-devel
    libdisplay-info-devel
    libseat-devel
    libxcb-devel
    xcb-util-image-devel
    xcb-util-renderutil-devel
    xcb-util-wm-devel
    xkeyboard-config
    xorg-server-xwayland
    glib-devel
    gmobile-devel
    gnome-desktop-devel
    json-glib-devel
    libdrm-devel
    libinput-devel
    libxkbcommon-devel
    MesaLib-devel
    pixman-devel
    wayland-protocols
    vulkan-loader-devel"
short_desc="Wlroots-based phone compositor for Phosh"
maintainer="Jaymz665 <jaymz665@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://gitlab.gnome.org/World/Phosh/phoc"
distfiles="${homepage}/-/archive/v${version}/${pkgname}-v${version}.tar.gz
    https://gitlab.gnome.org/GNOME/gvdb/-/archive/4758f6fb7f889e074e13df3f914328f3eecb1fd3/gvdb-4758f6fb7f889e074e13df3f914328f3eecb1fd3.tar.gz
    https://gitlab.gnome.org/Infrastructure/Mirrors/lorry-mirrors/gitlab_freedesktop_org/wlroots/wlroots/-/archive/0.19.2/wlroots-0.19.2.tar.gz"
checksum="7f8e529e2767e87aa15b92a588a9501add821d6c487d1745f0543eb6d7d4ee68
 da3680bd38314546a915df5ea265f8c963a42ff5ddc7d69dc1b339775f05dbd6
 f0530ecaa8739d15f97bd1e1edddb77e281d57e42d4263fccb67157f71730d17"

post_extract() {
    if [ -d "${wrksrc}/${pkgname}-v${version}" ]; then
        find "${wrksrc}/${pkgname}-v${version}" -mindepth 1 -maxdepth 1 \
            -exec mv -t "${wrksrc}/" {} +
        rmdir "${wrksrc}/${pkgname}-v${version}"
    fi

    rm -rf "${wrksrc}"/gvdb-4758f6fb7f889e074e13df3f914328f3eecb1fd3
    mkdir -p "${wrksrc}/subprojects/gvdb"
    bsdtar -xf "${XBPS_SRCDISTDIR}/${pkgname}-${version}/gvdb-4758f6fb7f889e074e13df3f914328f3eecb1fd3.tar.gz" \
        -C "${wrksrc}/subprojects/gvdb" --strip-components=1

    rm -rf "${wrksrc}"/wlroots-0.19.2
    mkdir -p "${wrksrc}/subprojects/wlroots-0.19.x"
    bsdtar -xf "${XBPS_SRCDISTDIR}/${pkgname}-${version}/wlroots-0.19.2.tar.gz" \
        -C "${wrksrc}/subprojects/wlroots-0.19.x" --strip-components=1

    patch_file=$(find "${wrksrc}" -name '0001-Revert-layer-shell-error-on-0-dimension-without-anch.patch' -print -quit)
    if [ -n "${patch_file}" ]; then
        patch -d "${wrksrc}/subprojects/wlroots-0.19.x" -p1 < "${patch_file}"
    fi
}

post_install() {
    if [ -d "${wrksrc}/LICENSES" ]; then
        vmkdir usr/share/licenses/phoc
        cp -r ${wrksrc}/LICENSES/* ${PKGDESTDIR}/usr/share/licenses/phoc/
    fi
}

phoc_package() {
    depends="phoc-schemas>=${version}_${revision}"
}

phoc-schemas_package() {
    short_desc="Phoc schemas"
    archs=noarch
    pkg_install() {
        vmove "usr/share/glib-2.0/schemas/*"
    }
}
