distfiles="${homepage}/-/archive/v${version}/${pkgname}-v${version}.tar.gz
    https://gitlab.gnome.org/GNOME/libgnome-volume-control/-/archive/5f9768a2eac29c1ed56f1fbb449a77a3523683b6/libgnome-volume-control-5f9768a2eac29c1ed56f1fbb449a77a3523683b6.tar.gz"
