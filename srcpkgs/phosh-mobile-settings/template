if [ -z "$XBPS_CHECK_PKGS" ]; then
    make_check_args="--suite unit"
fi

post_extract() {
    # 1) GitLab-архив распаковывается в phosh-mobile-settings-v0.52.0/
    if [ -d "${wrksrc}/${pkgname}-v${version}" ]; then
        find "${wrksrc}/${pkgname}-v${version}" -mindepth 1 -maxdepth 1 \
            -exec mv -t "${wrksrc}/" {} +
        rmdir "${wrksrc}/${pkgname}-v${version}"
    fi

    # 2) gvc — в subprojects/gvc
    rm -rf "${wrksrc}"/libgnome-volume-control-*
    mkdir -p "${wrksrc}/subprojects/gvc"
    bsdtar -xf "${XBPS_SRCDISTDIR}/${pkgname}-${version}/libgnome-volume-control-5f9768a2eac29c1ed56f1fbb449a77a3523683b6.tar.gz" \
        -C "${wrksrc}/subprojects/gvc" --strip-components=1

    # 3) Патч из gvc.wrap (diff_files)
    patch_file=$(find "${wrksrc}" -name '0001-mixer-control-Don-t-leak-ui-device.patch' -print -quit)
    if [ -n "${patch_file}" ]; then
        patch -d "${wrksrc}/subprojects/gvc" -p1 < "${patch_file}" || true
    fi
}

phosh-mobile-settings-lang_package() {
    short_desc+=" - language files"
    pkg_install() {
        vmove "usr/share/locale/*"
    }
}
