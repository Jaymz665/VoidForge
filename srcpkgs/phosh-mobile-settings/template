configure_args="-Db_lto=true"
hostmakedepends="
    desktop-file-utils
    gettext
    glib-devel
    gtk4-update-icon-cache
    gtk-update-icon-cache
    lm_sensors
    meson
    pkg-config
    wayland-devel"
makedepends="
    cellbroadcastd-devel
    feedbackd-devel
    gmobile-devel
    gnome-desktop-devel
    gsound-devel
    gtk4-devel
    json-glib-devel
    libadwaita-devel
    libportal-devel
    libportal-gtk4-devel
    libsensors-devel
    libyaml-devel
    phoc-schemas
    phosh-devel
    phosh-schemas
    pulseaudio-devel"
