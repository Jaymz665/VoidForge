From: Your Name <you@example.com>
Date: Thu, 27 Aug 2026 12:00:00 +0000
Subject: [PATCH 3/3] Add ExtraFunctionRow to main.qml

---
 src/qml/main.qml | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/src/qml/main.qml b/src/qml/main.qml
index 1234567..abcdefg 100644
--- a/src/qml/main.qml
+++ b/src/qml/main.qml
@@ -74,12 +74,28 @@ InputPanelWindow {
         // Padding for background corners and panel drag area
         readonly property real padding: isFullScreenWidth ? 0 : Kirigami.Units.largeSpacing
 
+        // Extra row height
+        readonly property real extraRowHeight: 48
+
         // Never let width & height to be 0, otherwise it can cause problems for setting interactiveRegion
         width: inputPanel.width > 0 ? (inputPanel.width + padding * 2) : 100
-        height: inputPanel.height > 0 ? (inputPanel.height + padding * 2) : 100
+        height: inputPanel.height > 0 ? (inputPanel.height + extraRowHeight + padding * 2) : (extraRowHeight + padding * 2)
+
+        ExtraFunctionRow {
+            id: extraRow
+            anchors {
+                top: parent.top
+                left: parent.left
+                right: parent.right
+                topMargin: padding
+                leftMargin: padding
+                rightMargin: padding
+            }
+            height: extraRowHeight
+        }
 
         InputPanel {
             id: inputPanel
             anchors {
-                top: parent.top
+                top: extraRow.bottom
                 topMargin: parent.padding
                 left: parent.left
                 leftMargin: parent.padding
