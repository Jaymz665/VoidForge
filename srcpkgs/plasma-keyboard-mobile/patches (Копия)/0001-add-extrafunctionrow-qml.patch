Subject: [PATCH 1/3] Add ExtraFunctionRow.qml

---
 src/qml/ExtraFunctionRow.qml | 66 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 66 insertions(+)
 create mode 100644 src/qml/ExtraFunctionRow.qml

diff --git a/src/qml/ExtraFunctionRow.qml b/src/qml/ExtraFunctionRow.qml
new file mode 100644
index 0000000..e112233
--- /dev/null
+++ b/src/qml/ExtraFunctionRow.qml
@@ -0,0 +1,66 @@
+/*
+    SPDX-FileCopyrightText: 2026 Your Name <you@example.com>
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+import QtQuick
+import QtQuick.VirtualKeyboard
+
+import org.kde.kirigami as Kirigami
+import org.kde.plasma.keyboard.lib as PlasmaKeyboard
+
+Item {
+    id: root
+    height: 48
+
+    Row {
+        anchors.fill: parent
+        spacing: Kirigami.Units.smallSpacing
+
+        Repeater {
+            model: [
+                { text: "Tab", key: Qt.Key_Tab },
+                { text: "Ctrl", key: Qt.Key_Control, isModifier: true },
+                { text: "Shift", key: Qt.Key_Shift, isModifier: true },
+                { text: "Alt", key: Qt.Key_Alt, isModifier: true },
+                { text: "←", key: Qt.Key_Left },
+                { text: "↑", key: Qt.Key_Up },
+                { text: "↓", key: Qt.Key_Down },
+                { text: "→", key: Qt.Key_Right }
+            ]
+
+            delegate: PlasmaKeyboard.BreezeKeyPanel {
+                width: (parent.width - parent.spacing * (parent.children.length - 1)) / parent.children.length
+                height: parent.height
+
+                property bool isModifier: modelData.isModifier || false
+                property bool pressed: false
+
+                Item {
+                    anchors.fill: parent
+                    Text {
+                        anchors.centerIn: parent
+                        text: modelData.text
+                        color: PlasmaKeyboard.BreezeConstants.keyTextColor
+                        font.pixelSize: 20
+                        font.weight: Font.Light
+                        horizontalAlignment: Text.AlignHCenter
+                        verticalAlignment: Text.AlignVCenter
+                    }
+                }
+
+                MouseArea {
+                    anchors.fill: parent
+                    onClicked: {
+                        if (isModifier) {
+                            pressed = !pressed;
+                            InputContext.inputEngine.sendKeyPress(modelData.key);
+                            if (!pressed) InputContext.inputEngine.sendKeyRelease(modelData.key);
+                        } else {
+                            InputContext.inputEngine.sendKeyPress(modelData.key);
+                            InputContext.inputEngine.sendKeyRelease(modelData.key);
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
