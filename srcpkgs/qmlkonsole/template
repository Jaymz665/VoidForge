# Template file for 'qmlkonsole'
pkgname=qmlkonsole
version=26.08.0
revision=1
build_style=cmake
configure_args="
	-DCMAKE_BUILD_TYPE=RelWithDebInfo
	-DCMAKE_INSTALL_PREFIX=/usr
	-DCMAKE_INSTALL_LIBDIR=lib
"
hostmakedepends="
	cmake
	ninja
	pkg-config
	extra-cmake-modules
	qt6-base
	qt6-declarative
	qt6-declarative-tools
	qt6-tools
	gettext
	kf6-ki18n
	kf6-kconfig
"
makedepends="
	kf6-ki18n-devel
	kf6-kirigami-devel
	kirigami-addons-devel
	kf6-kpty-devel
	qt6-qt5compat-devel
	qt6-base-devel
	qt6-declarative-devel
	qt6-svg-devel
	kf6-kconfig-devel
	kf6-kwindowsystem-devel
"
depends="
	kf6-kirigami
	kirigami-addons
"
short_desc="Terminal app for Plasma Mobile"
maintainer="Jaymz665 <jaymz665@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://invent.kde.org/plasma-mobile/qmlkonsole"
archs="aarch64* x86_64*"
distfiles="https://download.kde.org/stable/release-service/${version}/src/${pkgname}-${version}.tar.xz"
checksum=55a0d148eb735fee3ef6c797623198fde15d741598ddfe6c4a3c122a8a6dcb6a

pre_configure() {
    local host_libexec="/usr/lib/qt6/libexec"
    local target_libexec="/usr/aarch64-linux-gnu/usr/lib64/qt6/libexec"
    mkdir -p "$target_libexec"

    local tools=(
        qmltyperegistrar
        qmlcachegen
        qmlplugindump
        qmlsc
        qmllint
    )

    for tool in "${tools[@]}"; do
        if [ -f "$host_libexec/$tool" ]; then
            echo "Copying $tool to target libexec..."
            cp "$host_libexec/$tool" "$target_libexec/$tool"
            chmod +x "$target_libexec/$tool"
        else
            echo "Warning: $tool not found in host libexec, skipping"
        fi
    done
}
