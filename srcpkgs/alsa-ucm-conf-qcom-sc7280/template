# Template file for 'alsa-ucm-conf-qcom-sc7280'
pkgname=alsa-ucm-conf-qcom-sc7280
version=5
revision=4
_commit="46a53ef96fc18c2781305eb3e435fc98b1cd8a7a"
wrksrc="alsa-ucm-config-${_commit}"

hostmakedepends="git"
archs="aarch64"
short_desc="ALSA UCM configuration for Qualcomm SC7280/SM7325 devices"
maintainer="Jaymz665 <jaymz665@gmail.com>"
license="BSD-3-Clause"
homepage="https://altlinux.space/neko/alsa-ucm-config"
distfiles=""
checksum=
provides="alsa-ucm-conf-0.${version}_${revision}"

nofetch=yes
noextract=yes

do_fetch() {
	msg_normal "Cloning alsa-ucm-config from ALT Linux (commit ${_commit})...\n"
	git init "${wrksrc}"
	cd "${wrksrc}"
	git remote add origin https://altlinux.space/neko/alsa-ucm-config.git
	git fetch --depth 1 origin "${_commit}"
	git checkout FETCH_HEAD
}

do_install() {
    vmkdir usr/share/alsa/ucm2
    cp -a ucm2/Nothing "${DESTDIR}/usr/share/alsa/ucm2/"

    vmkdir usr/share/alsa/ucm2/conf.d/sm8250
    vinstall ucm2/conf.d/sm8250/NP1.conf 644 usr/share/alsa/ucm2/conf.d/sm8250

    vmkdir usr/share/alsa/ucm2/conf.d/sm7325
    vinstall ucm2/conf.d/sm7325/NP1.conf 644 usr/share/alsa/ucm2/conf.d/sm7325

    vmkdir usr/share/alsa/ucm2/codecs/wcd938x
    vinstall ucm2/codecs/wcd938x/AnalogMic2EnableSeq.conf 644 \
        usr/share/alsa/ucm2/codecs/wcd938x
    vinstall ucm2/codecs/wcd938x/AnalogMic2DisableSeq.conf 644 \
        usr/share/alsa/ucm2/codecs/wcd938x

    vmkdir usr/share/alsa/ucm2/codecs/qcom-lpass/tx-macro
    vinstall ucm2/codecs/qcom-lpass/tx-macro/SoundwireMic5EnableSeq.conf 644 \
        usr/share/alsa/ucm2/codecs/qcom-lpass/tx-macro
}
