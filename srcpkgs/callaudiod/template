# Template file for 'callaudiod'
pkgname=callaudiod
version=0.1.99
revision=2
build_style=meson
hostmakedepends="pkg-config"
makedepends="
    alsa-lib-devel pulseaudio-devel AppStream-devel glib-devel"
short_desc="Call audio routing daemon"
maintainer="Jaymz665"
license="LGPL-3.0-or-later"
homepage="https://gitlab.com/mobian1/callaudiod"
distfiles="https://gitlab.com/mobian1/callaudiod/-/archive/${version}/callaudiod-${version}.tar.gz"
checksum=6b8214fb1fa08fa89012d8c85d671a61be37ad33373065daf7ae17bd703bd0ad

callaudiod_package() {
    depends="libcallaudio>=${version}_${revision}"
}

libcallaudio_package() {
    short_desc="Library for call audio handling"
    pkg_install() {
        vmove "usr/lib/*.so.*"
    }
}

callaudiod-devel_package() {
    short_desc="Development files for callaudiod"
    depends="libcallaudio>=${version}_${revision} callaudiod>=${version}_${revision}"
    pkg_install() {
        vmove usr/include
        vmove usr/lib/pkgconfig
        vmove "usr/lib/*.so"
    }
}

callaudiocli_package() {
    short_desc="CLI for callaudiod"
    pkg_install() {
        vmove usr/bin/callaudiocli
    }
}
